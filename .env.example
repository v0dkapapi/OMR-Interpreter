# OMR Interpreter Environment Configuration Template
# Copy this file to .env and customize paths as needed for your local machine.

# Path to the external dataset root directory containing vision_ds/ and stress_test/
# If omr-data is cloned next to omr-interpreter, this default works automatically.
OMR_DATA_ROOT=../omr-data/data

# Optional training overrides (uncomment to override defaults)
# OMR_EPOCHS=5
# OMR_BATCH_SIZE=64
# OMR_SUBSET_SIZE=3000
# OMR_LR=0.001

# Set to 1 to forbid OCR model downloads (pre-seed models/ocr_cache/easyocr/ first)
# OMR_OFFLINE=1

# PyTorch hardware acceleration settings
PYTORCH_ENABLE_MPS_FALLBACK=1
